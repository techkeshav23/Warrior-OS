# ═══════════════════════════════════════════════════════════
# WARRIOR OS — environment variables
# Copy to .env.local (local dev) or add in Vercel → Settings →
# Environment Variables. Every value is optional: with none set the OS
# runs fully offline-first (browser storage, NEXUS offline brain,
# keyless Open-Meteo weather, a local Ghost Warriors campfire).
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build
# time, so they are public by design. Everything else stays server-side.
# ═══════════════════════════════════════════════════════════

# ─── Server only (secrets) ───

# Gemini API key from Google AI Studio, used by /api/ai. Empty → NEXUS uses its offline brain.
GEMINI_API_KEY=
# OpenWeatherMap API key, used by /api/weather. Empty → keyless Open-Meteo.
WEATHER_API_KEY=

# ─── Firebase web app (public; protect data with Firebase security rules) ───

# Firebase console → Project settings → Your apps → Web app → apiKey.
NEXT_PUBLIC_FIREBASE_API_KEY=
# authDomain, e.g. your-project.firebaseapp.com.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# projectId. With the apiKey, turns on Firestore sync for signed-in users.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# storageBucket, e.g. your-project.firebasestorage.app.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# messagingSenderId.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# appId.
NEXT_PUBLIC_FIREBASE_APP_ID=
# Realtime Database URL, e.g. https://your-project-default-rtdb.firebaseio.com. Turns on live Ghost Warriors presence + war cries.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ─── Site ───

# Public origin for absolute link-preview URLs, e.g. https://warrior-os.vercel.app. Empty → Vercel production domain (required when hosting anywhere else).
NEXT_PUBLIC_SITE_URL=

# Set automatically, do not add: NODE_ENV (Next.js) and VERCEL_PROJECT_PRODUCTION_URL (Vercel).
# Never put the Gemini or weather key under a NEXT_PUBLIC_ name: that would ship it to every browser.

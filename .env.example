# ═══════════════════════════════════════════════════════════
# WARRIOR OS — environment variables
# Copy to .env.local (local dev) or add in Coolify / Vercel →
# Environment Variables. Every value is optional: with none set the OS
# runs fully offline-first (browser storage, NEXUS offline brain,
# keyless Open-Meteo weather, a local Ghost Warriors campfire, no sync).
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build
# time, so they are public by design. Everything else stays server-side.
# ═══════════════════════════════════════════════════════════

# ─── Server only (secrets) ───

# Gemini API key from Google AI Studio, used by /api/ai. Empty → NEXUS uses its offline brain.
GEMINI_API_KEY=
# OpenWeatherMap API key, used by /api/weather. Empty → keyless Open-Meteo.
WEATHER_API_KEY=

# ─── Owner sync (server only; never add a NEXT_PUBLIC_ version) ───

# Temporary owner password (8+ chars) for the first sign-in, which then asks for your own. Empty → sync off.
OWNER_PASSWORD=
# Folder where sync.json is written. Empty → ./.data (the Docker image sets /data; mount a persistent volume there).
WARRIOR_DATA_DIR=

# ─── JARVIS (NEXUS with tools; owner only, needs OWNER_PASSWORD; server only) ───

# Google Cloud project id → JARVIS runs on Vertex AI. Empty → uses GEMINI_API_KEY if set.
VERTEX_PROJECT=
# Vertex region. Empty → global.
VERTEX_LOCATION=
# Service-account key JSON (raw or base64). Empty → the VM's own service account via the metadata server.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Gemini model for JARVIS. Empty → gemini-2.5-flash.
JARVIS_MODEL=
# Text-to-Speech voice for spoken replies (needs VERTEX_PROJECT + texttospeech API). Empty → en-IN-Neural2-B; off → browser voice.
JARVIS_VOICE=

# ─── Site ───

# Public origin for absolute link-preview URLs, e.g. https://warrior-os.vercel.app. Empty → Vercel production domain (required when hosting anywhere else).
NEXT_PUBLIC_SITE_URL=

# Set automatically, do not add: NODE_ENV (Next.js) and VERCEL_PROJECT_PRODUCTION_URL (Vercel).
# Never put the Gemini, weather or sync values under a NEXT_PUBLIC_ name: that would ship them to every browser.
